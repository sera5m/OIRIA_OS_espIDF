print("siggen lib");

// square 1 kHz @ 50% on GPIO 4 — single call (still one UART translate on tyrant)
print(native("wave", 1, 1000, 50, 4, 80));

// burst: one NSQ1 blob, C trampoline on the device
print(native_seq(
  native("wave", 1, 1000, 50, 4, 80),
  native("delay", 250),
  native("wave", 0, 440, 50, 4, 80),
  native("delay", 250),
  native("wave_stop")
));
