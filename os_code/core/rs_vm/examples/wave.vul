// PWM function generator. S3 has no DAC — RC on GPIO 4.
// native("wave", kind, hz, duty, pin, amp)
//   kind 0=sine 1=square 2=triangle 3=saw

print("square 1k");
print(native("wave", 1, 1000, 50, 4, 80));
delay_ms(1500);

print("sine 440 (duty-DDS + LPF)");
print(native("wave", 0, 440, 50, 4, 80));
delay_ms(1500);

print("triangle 220");
print(native("wave", 2, 220, 50, 4, 80));
delay_ms(1500);

print("sweep 100 -> 2k in 2s");
print(native("sweep", 100, 2000, 2000));
delay_ms(2200);

print("scope GPIO1 mV");
print(native("adc", 1));

print(native("wave_stop"));
print("stopped");
